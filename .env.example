# Sao chép thành .env (KHÔNG commit .env). Chỉ dùng ví test.

# ------------------------------------------------------------------------------
# 1. CONTRACT (Foundry: contracts/)
# ------------------------------------------------------------------------------
# Ví Owner / Deployer trên Fuji (cần ít test AVAX trả gas deploy & fork test)
PRIVATE_KEY=
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
SNOWTRACE_API_KEY=

# Chu kỳ hạn mức mặc định: 30s cho demo, 86400s (1 ngày) cho production
DEMO_PERIOD_SECONDS=30

# Địa chỉ contract sau khi deploy trên Fuji (để trống khi chưa deploy)
AGENT_POLICY_FACTORY_ADDRESS=
AGENT_POLICY_ADDRESS=

# ------------------------------------------------------------------------------
# 2. AGENT (agent/ — Gemini + Rule Engine + x402 client)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AGENT_PRIVATE_KEY=
MAX_PRICE_USDC=0.01

# ------------------------------------------------------------------------------
# 3. SELLERS (sellers/ — 2 API mock thời tiết & tỷ giá qua x402)
# ------------------------------------------------------------------------------
NETWORK=fuji
FACILITATOR_URL=http://localhost:4022
WEATHER_API_PORT=4021
WEATHER_PAY_TO=0x9D014376C3296db41770015AF074CF4D14c075E1
WEATHER_PRICE_USDC=0.001

RATES_API_PORT=4023
RATES_PAY_TO=0x8D299966B407e9f189C1920f5A7324F13a9a4110
RATES_PRICE_USDC=0.001

# ------------------------------------------------------------------------------
# 4. FACILITATOR TỰ HOST (tùy chọn chạy local cho demo)
# ------------------------------------------------------------------------------
FACILITATOR_PORT=4022
FACILITATOR_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 5. WEB (Next.js: web/)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
NEXT_PUBLIC_AGENT_POLICY_FACTORY_ADDRESS=
NEXT_PUBLIC_AGENT_POLICY_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
